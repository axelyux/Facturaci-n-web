# Plantilla SIN valores reales. Copiar a .env (ignorado por git) o usar user-secrets / gestor de secretos.
# Nunca poner contraseñas, cadenas de conexión reales ni claves en este archivo.

# --- API (src/api) ---
ASPNETCORE_ENVIRONMENT=Development
# ConnectionStrings__Integration=<cadena de la BD de integración propia, NO la de Comercial Pro>

# --- Web (src/web) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5110

# --- Conector local (src/connector) ---
# Connector__PortalBaseUrl=<url HTTPS del portal>
# Connector__ClientCredential=<credencial del conector; se guarda cifrada, ver docs/SEGURIDAD.md>

# --- Diagnóstico de solo lectura (scripts/diagnostico; solo en el equipo autorizado) ---
# CONTPAQ_SQL_SERVER=<equipo\instancia>
# CONTPAQ_SQL_USER=<usuario>
# CONTPAQ_SQL_PASSWORD=<NO escribir aquí; definir solo en la sesión>
# CONTPAQ_SQL_DATABASE=SONARMANDO
